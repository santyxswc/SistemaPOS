# Copie este archivo como .env y ajuste los valores.

# development = servidor de Flask con recarga; production = waitress (funciona en Windows y Linux)
POS_ENV=development

# Obligatoria en producción, mínimo 32 caracteres. Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
POS_SECRET_KEY=

POS_DATABASE_PATH=data/pos.sqlite3
POS_BUSINESS_NAME=Mi negocio
POS_HOST=127.0.0.1
POS_PORT=8000

# Duración de la sesión en minutos (720 = un turno de 12 horas)
POS_TOKEN_TTL_MINUTES=720

# Orígenes del frontend separados por coma, p. ej. http://localhost:5173
POS_CORS_ORIGINS=

# Facturación electrónica (DIAN). Vacío = desactivada. "simulado" = pruebas sin validez ante la DIAN.
POS_INVOICE_PROVIDER=
